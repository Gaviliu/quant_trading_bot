{
    "name": "quant_trading_bot (Codespaces)",
    "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
    "features": {
      "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "postCreateCommand": "python -m pip install -U pip && pip install -e .",
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "ms-toolsai.jupyter"
        ]
      }
    },
    "updateContentCommand": "pip install -e ."
  }
  